NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# pretty (default when NODE_ENV=local) or json
LOG_FORMAT=json
CORS_ORIGIN=*
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Set to true for managed Postgres that requires TLS (RDS, Cloud SQL, Neon, ...)
DATABASE_SSL=false

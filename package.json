{
  "name": "express-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Express boilerplate with TypeScript, Drizzle/Postgres, Zod, and Pino",
  "main": "dist/server.js",
  "scripts": {
    "predev": "pnpm db:up",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:docker": "docker compose up --build app",
    "ci:local": "pnpm db:up && pnpm exec biome ci . && pnpm typecheck && POSTGRES_DB=app_test RUN_DB_TESTS=1 pnpm exec tsx src/db/migrate.ts && POSTGRES_DB=app_test RUN_DB_TESTS=1 pnpm test && pnpm build",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:reset": "docker compose rm -sf db && docker volume rm -f express-boilerplate_pgdata && pnpm db:up",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "express",
    "typescript",
    "biome",
    "zod",
    "pino"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.7.0"
}
